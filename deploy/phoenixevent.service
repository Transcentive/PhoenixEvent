# PhoenixEvent API: systemd unit for Ubuntu 22.04.
#
# Install:
#   sudo cp deploy/phoenixevent.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now phoenixevent
#
# The binary applies migrations at startup and exits non-zero if one fails, so
# a failed migration shows as a failed unit and never as a server answering on
# a half-built schema.

[Unit]
Description=PhoenixEvent API
Documentation=https://github.com/Transcentive/PhoenixEvent
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=phoenixevent
Group=phoenixevent
WorkingDirectory=/srv/phoenixevent/app/backend

# Secrets live here, readable only by the service user. Never in the repository.
EnvironmentFile=/srv/phoenixevent/app/backend/.env
ExecStart=/srv/phoenixevent/app/backend/phoenixevent-server

Restart=on-failure
RestartSec=5s
# Five failures inside a minute means a real problem: stop restarting and let
# the unit show as failed.
StartLimitBurst=5
StartLimitIntervalSec=60

# --- hardening -------------------------------------------------------------
# The service needs its own working directory (read), the file store (write)
# and a network socket. Nothing else.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

# ProtectSystem=strict makes the whole filesystem read-only, so the one path
# the process writes to, STORAGE_PATH, is granted back.
ReadWritePaths=/srv/phoenixevent/data

[Install]
WantedBy=multi-user.target
