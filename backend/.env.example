# PhoenixEvent API. Copy to .env, or let scripts/setup-local-db.sh write it.
# .env is never committed.

DATABASE_URL=postgres://phoenixevent:CHANGE_ME@localhost:5433/phoenixevent?sslmode=disable
PORT=8082

# Where files are kept on this machine.
STORAGE_PATH=/absolute/path/to/files

# Email. With SMTP_HOST empty, messages are written to the server log.
# On the droplet these are the Rackspace account's SMTP settings (spec 2A.2).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# Addresses (spec 4A.5). Each organization is at <name>.<ORG_DOMAIN>, and
# ORG_DOMAIN alone is the general address. On the droplet during testing:
# phoenixevent.tomsherlock.space, https, no port. On a development Mac:
# phoenixevent.localhost, http, 5174, COOKIE_SECURE=false.
ORG_DOMAIN=phoenixevent.tomsherlock.space
SITE_SCHEME=https
SITE_PORT=
COOKIE_SECURE=true

# Signs access tokens. At least 32 characters: openssl rand -hex 32
JWT_SECRET=CHANGE_ME

# Development Mac only: the organization a phone on the same Wi-Fi reaches at
# the Mac's Wi-Fi address (scripts/run-local.sh sets LAN_ADDRESS). Empty on the
# droplet.
LAN_ORGANIZATION=
